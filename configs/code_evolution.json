{
  "mode": "python",
  "bank": ["pelt", "bottom_up", "window", "changeforest_rf", "changeforest_knn", "bayesian_offline", "spectral", "klcpd"],
  "agent": {"k": 3, "iterations": 8, "epsilon": 0.005, "vision": true, "repairs": 2},
  "llm": {
